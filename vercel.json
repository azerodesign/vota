{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/vota.ps1", "destination": "https://vota.axy.my.id/vota.ps1" },
    { "source": "/vota.sh", "destination": "https://vota.axy.my.id/vota.sh" },
    { "source": "/termux", "destination": "https://vota.axy.my.id/termux" },
    { "source": "/bridge.ps1", "destination": "https://vota.axy.my.id/bridge.ps1" },
    { "source": "/bridge.sh", "destination": "https://vota.axy.my.id/bridge.sh" },
    { "source": "/install.ps1", "destination": "https://vota.axy.my.id/install.ps1" },
    { "source": "/install.sh", "destination": "https://vota.axy.my.id/install.sh" },
    { "source": "/tcpip.ps1", "destination": "https://vota.axy.my.id/tcpip.ps1" },
    { "source": "/bridge.py", "destination": "https://vota.axy.my.id/bridge.py" },
    { "source": "/download/:path*", "destination": "https://vota.axy.my.id/download/:path*" },
    { "source": "/api/:path*", "destination": "https://vota.axy.my.id/api/:path*" },
    { "source": "/((?!assets/|favicon.svg|favicon.ico).*)", "destination": "/index.html" }
  ]
}
