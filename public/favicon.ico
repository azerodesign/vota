<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="votaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563eb" />
      <stop offset="50%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#4f46e5" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#0284c7" flood-opacity="0.5"/>
    </filter>
  </defs>
  <!-- Background Squircle -->
  <rect x="4" y="4" width="56" height="56" rx="16" fill="url(#votaGrad)" />
  <!-- Radar Wave Ring -->
  <circle cx="32" cy="32" r="23" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-opacity="0.25" stroke-dasharray="3 3"/>
  <circle cx="32" cy="32" r="17" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-opacity="0.35"/>
  <!-- Central Electric Lightning Pulse Symbol -->
  <path d="M35 15 L22 33 L30 33 L27 49 L42 29 L33 29 Z" fill="#ffffff" filter="url(#glow)"/>
  <!-- Status Dot -->
  <circle cx="48" cy="16" r="3.5" fill="#10b981" stroke="#ffffff" stroke-width="1.5"/>
</svg>
